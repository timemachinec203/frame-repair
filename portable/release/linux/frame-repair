#!/usr/bin/env bash
# Opens the Frame Repair app: ./frame-repair [clips...]
set -euo pipefail
here="$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")" && pwd)"
if [ ! -x "$here/app/.venv/bin/python" ]; then
  echo "Frame Repair isn't set up yet: run ./install.sh first." >&2
  exit 1
fi
cd "$here/app"
exec "$here/app/.venv/bin/python" -m frame_repair.gui "$@"
